# Public URLs of the deployed demos (each demo is its own deployment).
# Leave unset locally - they default to http://localhost:3001 … 3004.
NEXT_PUBLIC_NOIR_URL=https://noir-yourname.vercel.app
NEXT_PUBLIC_VANTA_URL=https://vanta-yourname.vercel.app
NEXT_PUBLIC_ATELIER_URL=https://atelier-yourname.vercel.app
NEXT_PUBLIC_NOVA_URL=https://nova-yourname.vercel.app

# This site's own public URL (used for Open Graph images).
NEXT_PUBLIC_SITE_URL=https://yourstudio.vercel.app

# Where "Let's Talk" buttons go: a mailto: link or a booking/contact page.
NEXT_PUBLIC_CONTACT_URL=mailto:you@yourstudio.com?subject=New%20website%20project
